# CLIProxyAPI Management API Key (plaintext secret key configured in CLIProxyAPI config.yaml)
ANTI_UI_MGMT_KEY=your_management_secret_key_here

# CLIProxyAPI address (default: http://127.0.0.1:8317)
ANTI_UI_PROXY_URL=http://127.0.0.1:8317

# Server listening port (default: 4310)
ANTI_UI_PORT=4310

# Web frontend origin for CORS
ANTI_UI_WEB_ORIGIN=http://127.0.0.1:4321

# Optional: AgentRouter gateway address (default: http://127.0.0.1:15721)
# ANTI_UI_AGENTROUTER_URL=http://127.0.0.1:15721

# Optional: WorkBuddy gateway (workbuddy2api) address and its bearer key
# ANTI_UI_WORKBUDDY_URL=http://127.0.0.1:7863
# ANTI_UI_WORKBUDDY_KEY=

# Optional: delete usage records older than N days (default 0 = keep everything)
# ANTI_UI_USAGE_RETENTION_DAYS=0

# ---- Remote access (see docs/REMOTE.md). Off by default: loopback-only, no login. ----
# ANTI_UI_REMOTE=1
# ANTI_UI_ADMIN_TOKEN=            # >= 24 chars, e.g. `openssl rand -base64 36`
# ANTI_UI_VIEW_TOKEN=             # optional read-only token, >= 24 chars, different from admin
# ANTI_UI_ALLOWED_HOSTS=dash.example.com   # exact Host header(s) the tunnel presents, comma separated
# ANTI_UI_WEB_ORIGINS=            # extra allowed browser origins (default: https://<allowed host>)
# ANTI_UI_TRUSTED_PROXY=1         # trust CF-Connecting-IP / X-Forwarded-For (only if the tunnel is the sole way in)
# ANTI_UI_RECORD_KEY=             # lets local scripts POST /api/usage/record via the X-Record-Key header
# ANTI_UI_SESSION_HOURS=12
# ANTI_UI_BIND_HOST=127.0.0.1     # non-loopback values are refused unless ANTI_UI_REMOTE=1
